PORT=8782
NODE_ENV=development

# External effects stay fail-closed until W5 certification.
WHATSAPP_PRODUCTION_SEND=false
WHATSAPP_BULK_SEND=false
WHATSAPP_AI_AUTOREPLY=false
WHATSAPP_EXTERNAL_RECIPIENTS=false

# W3 durable application state. Use a persistent mounted path in integration/staging.
WHATSAPP_DATA_DIR=./var/whatsapp
WHATSAPP_MAX_INBOUND_ATTEMPTS=5
WHATSAPP_BASE_RETRY_MS=1000
WHATSAPP_MAX_PAGE_SIZE=100

# Internal ingress/metrics authentication. Required for internal W3 routes.
WHATSAPP_INTERNAL_API_TOKEN=

# Operator auth. Production refuses to start with WHATSAPP_AUTH_REQUIRED=false.
WHATSAPP_AUTH_REQUIRED=true
WHATSAPP_AUTH_ISSUER=
WHATSAPP_AUTH_AUDIENCE=codestra-whatsapp
# PEM public key; multiline values may use literal \\n escapes.
WHATSAPP_AUTH_PUBLIC_KEY=

# Canonical effect boundary.
MIDDLEWARE_BASE_URL=http://middleware-integration-api:8095
MIDDLEWARE_COMMAND_PATH=/platform/v1/commands
# Keep empty until the reviewed Middleware V3 WhatsApp command family is deployed.
MIDDLEWARE_COMMAND_TYPE=
MIDDLEWARE_TARGET=
MIDDLEWARE_CAPABILITY=

# Separate frontend origin. Leave empty to deny browser CORS preflight.
WHATSAPP_FRONTEND_ORIGIN=
